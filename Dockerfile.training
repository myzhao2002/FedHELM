ARG PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
FROM ${PYTHON_IMAGE}
WORKDIR /app
COPY requirements.lock.txt .
RUN pip install --no-cache-dir -r requirements.lock.txt
RUN pip install --no-cache-dir --retries 12 filelock==3.32.3 setuptools==78.1.0 sympy==1.14.0 networkx==3.6.1 jinja2==3.1.6 fsspec==2026.7.0
RUN pip install --no-cache-dir --retries 12 --no-deps torch==2.14.0+cpu --index-url https://download.pytorch.org/whl/cpu
COPY fedhelm ./fedhelm
COPY scripts ./scripts
ENV DATA_DIR=/data OMP_NUM_THREADS=1 MKL_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1
CMD ["python", "-m", "uvicorn", "fedhelm.edge:app", "--host", "0.0.0.0", "--port", "8000"]

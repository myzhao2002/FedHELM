{
  "openapi": "3.1.0",
  "info": {
    "title": "FedHELM · 语言模型模拟接口",
    "description": "FedHELM中文接口文档。大小语言模型保留替身，轻量模型支持真实PyTorch训练。点击接口查看输入输出，使用“Try it out”进行测试。",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "模块接口"
        ],
        "summary": "检查服务存活状态",
        "description": "返回进程状态与模拟标记；业务是否恢复请查看观测结果。",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/infer": {
      "post": {
        "tags": [
          "模块接口"
        ],
        "summary": "生成诊断与处置方案（模拟）",
        "description": "接收观测、候选根因和案例；当前用固定动作映射替代真实语言模型。",
        "operationId": "infer_infer_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InferenceRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Plan"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Case": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "case_id": {
            "type": "string",
            "title": "Case Id"
          },
          "source_node": {
            "type": "string",
            "title": "Source Node"
          },
          "diagnosis": {
            "$ref": "#/components/schemas/Diagnosis"
          },
          "plan": {
            "$ref": "#/components/schemas/Plan"
          },
          "feedback": {
            "$ref": "#/components/schemas/Feedback"
          },
          "root_cause_confirmed": {
            "type": "boolean",
            "title": "Root Cause Confirmed",
            "default": false
          },
          "label_source": {
            "type": "string",
            "enum": [
              "unconfirmed",
              "synthetic_injector",
              "testbed_injector",
              "operator"
            ],
            "title": "Label Source",
            "default": "unconfirmed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "case_id",
          "source_node",
          "diagnosis",
          "plan",
          "feedback"
        ],
        "title": "Case"
      },
      "Diagnosis": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "root_cause": {
            "type": "string",
            "enum": [
              "healthy",
              "service_down",
              "config_error",
              "pool_exhausted",
              "thread_pool_exhausted",
              "dependency_timeout",
              "unknown"
            ],
            "title": "Root Cause"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "embedding": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 384,
            "minItems": 4,
            "title": "Embedding"
          },
          "embedding_version": {
            "type": "string",
            "title": "Embedding Version",
            "default": "mock-features-v1"
          },
          "model_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Model Version"
          },
          "evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence"
          },
          "probabilities": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Probabilities"
          },
          "source": {
            "type": "string",
            "title": "Source",
            "default": "legacy"
          },
          "memory_conflict": {
            "type": "boolean",
            "title": "Memory Conflict",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "root_cause",
          "confidence",
          "embedding",
          "model_version",
          "evidence"
        ],
        "title": "Diagnosis"
      },
      "Feedback": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "success": {
            "type": "boolean",
            "title": "Success"
          },
          "samples": {
            "items": {
              "$ref": "#/components/schemas/Observation"
            },
            "type": "array",
            "title": "Samples"
          },
          "criterion": {
            "type": "string",
            "title": "Criterion"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "success",
          "samples",
          "criterion"
        ],
        "title": "Feedback"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferenceRequest": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "observation": {
            "$ref": "#/components/schemas/Observation"
          },
          "diagnosis": {
            "$ref": "#/components/schemas/Diagnosis"
          },
          "retrieved_cases": {
            "items": {
              "$ref": "#/components/schemas/Case"
            },
            "type": "array",
            "maxItems": 20,
            "title": "Retrieved Cases"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "observation",
          "diagnosis"
        ],
        "title": "InferenceRequest"
      },
      "Observation": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "service_id": {
            "type": "string",
            "title": "Service Id"
          },
          "healthy": {
            "type": "boolean",
            "title": "Healthy"
          },
          "error_rate": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Error Rate"
          },
          "latency_ms": {
            "type": "number",
            "minimum": 0.0,
            "title": "Latency Ms"
          },
          "pool_usage": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Pool Usage"
          },
          "logs": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Logs"
          },
          "workload_backend": {
            "type": "string",
            "enum": [
              "synthetic",
              "process",
              "kubernetes"
            ],
            "title": "Workload Backend",
            "default": "synthetic"
          },
          "response_codes": {
            "items": {
              "type": "integer"
            },
            "type": "array",
            "title": "Response Codes"
          },
          "business_pid": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Business Pid"
          },
          "pod_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pod Name"
          },
          "metrics": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Metrics"
          },
          "spans": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Spans"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "node_id",
          "service_id",
          "healthy",
          "error_rate",
          "latency_ms",
          "pool_usage",
          "logs"
        ],
        "title": "Observation"
      },
      "Plan": {
        "properties": {
          "schema_version": {
            "type": "string",
            "const": "1.0",
            "title": "Schema Version",
            "default": "1.0"
          },
          "simulated": {
            "type": "boolean",
            "const": true,
            "title": "Simulated",
            "default": true
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "node_id": {
            "type": "string",
            "title": "Node Id"
          },
          "service_id": {
            "type": "string",
            "title": "Service Id"
          },
          "mode": {
            "type": "string",
            "enum": [
              "lightweight",
              "local",
              "edge"
            ],
            "title": "Mode"
          },
          "root_cause": {
            "type": "string",
            "enum": [
              "healthy",
              "service_down",
              "config_error",
              "pool_exhausted",
              "thread_pool_exhausted",
              "dependency_timeout",
              "unknown"
            ],
            "title": "Root Cause"
          },
          "confidence": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Confidence"
          },
          "action": {
            "type": "string",
            "enum": [
              "none",
              "restart_service",
              "restore_config",
              "reset_pool",
              "reset_workers",
              "restore_dependency"
            ],
            "title": "Action"
          },
          "parameters": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Parameters"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "node_id",
          "service_id",
          "mode",
          "root_cause",
          "confidence",
          "action",
          "reason"
        ],
        "title": "Plan"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}